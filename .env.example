# OmniQuant Environment Configuration
# System Mode: simulated / paper / live
OMNIQUANT_ENV=paper
DEBUG=True

# Data Provider API Keys
OPENBB_PAT=
POLYGON_API_KEY=
FMP_API_KEY=
FRED_API_KEY=

# LLM API Keys (System 2 Research Engine: TradingAgents)
LLM_PROVIDER=deepseek # deepseek / openai / anthropic / ollama
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# System 1 Decision Engine (Laya / Jev)
DECISION_ENGINE=laya # laya / jev / rule_fallback
LAYA_DEVICE=mps # mps / cpu / cuda
JEV_API_KEY=
JEV_ENDPOINT=

# Domestic A-Share & Futures Execution (QMT / CTP SimNow)
CTP_USER_ID=
CTP_PASSWORD=
CTP_BROKER_ID=9999
CTP_MD_FRONT=tcp://180.168.146.187:10131
CTP_TD_FRONT=tcp://180.168.146.187:10130
QMT_PATH=/path/to/xtquant/userdata_mini

# Crypto Exchange Execution (CCXT)
CRYPTO_EXCHANGE=binance # binance / okx
CRYPTO_API_KEY=
CRYPTO_SECRET=
CRYPTO_PASSWORD=
CRYPTO_TESTNET=True

# Interactive Brokers (IBKR TWS / Gateway)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
